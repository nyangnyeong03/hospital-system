﻿﻿@{
ViewData["Title"] = "Home";
}

<style>

    html {
        scroll-behavior: smooth;
    }

    body {
        margin: 0;
        padding: 0;
        overflow-x: hidden;
        background: #f8fafc;
    }

    /* HERO */

    .hero {
        min-height: 100vh;
        background: linear-gradient(rgba(0,0,0,0.65), rgba(0,0,0,0.65)), url('/images/hospital.jpg');
        background-size: cover;
        background-position: center;
        display: flex;
        align-items: center;
        justify-content: center;
        text-align: center;
        color: white;
        padding: 40px 20px;
        overflow: hidden;
    }

    .hero-content {
        transition: transform 0.2s linear;
        will-change: transform;
    }

    .hero h1,
    .hero h2,
    .hero p {
        text-shadow: 2px 2px 10px rgba(0,0,0,0.5);
    }

    /* SECTION */

    .section {
        padding: 80px 20px;
    }

    .section-title {
        text-align: center;
        font-weight: bold;
        margin-bottom: 50px;
        color: #0f172a;
    }

    /* CAROUSEL */

    .custom-carousel {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 25px;
        flex-wrap: nowrap;
    }

    .main-card {
        width: 380px;
        background: white;
        border-radius: 20px;
        overflow: hidden;
        box-shadow: 0 12px 30px rgba(0,0,0,0.15);
        transition: 0.4s;
        flex-shrink: 0;
    }

        .main-card:hover {
            transform: scale(1.02);
        }

        .main-card img {
            width: 100%;
            height: 340px;
            object-fit: cover;
        }

    .side-card {
        width: 200px;
        border-radius: 15px;
        overflow: hidden;
        transition: 0.4s;
        flex-shrink: 0;
    }

        .side-card img {
            width: 100%;
            height: 280px;
            object-fit: cover;
        }

    .faded {
        opacity: 0.35;
        transform: scale(0.92);
    }

    .card-info {
        padding: 20px;
        text-align: center;
    }

        .card-info h4 {
            color: #0d6efd;
            font-weight: bold;
            margin-bottom: 15px;
        }

        .card-info ul {
            text-align: left;
            padding-left: 20px;
        }

    /* ABOUT */

    .about-box {
        background: white;
        border-radius: 20px;
        padding: 30px;
        box-shadow: 0 8px 20px rgba(0,0,0,0.08);
    }

    /* FOOTER */

    footer {
        background: #0f172a;
        color: white;
        text-align: center;
        padding: 20px;
        margin-top: 50px;
    }

    /* RESPONSIVE */

    @@media(max-width: 992px) {

        .custom-carousel {
            flex-direction: column;
        }

        .side-card {
            display: none;
        }

        .main-card {
            width: 100%;
        }

        .hero h1 {
            font-size: 2.3rem !important;
        }

        .hero h2 {
            font-size: 1.4rem !important;
        }

        .hero p {
            font-size: 1rem !important;
        }
    }

</style>

<!-- HERO -->

<div class="hero">

    <div class="container hero-content">

        <img src="/images/acdc.png"
