@model CahwciHospital.Models.Department

@{
    ViewData["Title"] = "Department Details";
    Layout = "_Layout";
}

<div class="container mt-5">
    <div class="row">
        <div class="col-md-8 offset-md-2">
            <div class="card shadow">
                <div class="card-header bg-info text-white">
                    <h3>Department Details</h3>
                </div>
                <div class="card-body">
                    <dl class="row">
                        <dt class="col-sm-4">ID</dt>
                        <dd class="col-sm-8">@Model.Id</dd>

                        <dt class="col-sm-4">Department Name</dt>
                        <dd class="col-sm-8">@Model.DepartmentName</dd>

                        <dt class="col-sm-4">Description</dt>
                        <dd class="col-sm-8">@Model.Description</dd>

                        <dt class="col-sm-4">Head Doctor</dt>
                        <dd class="col-sm-8">@Model.HeadDoctor</dd>
                    </dl>
                </div>
                <div class="card-footer">
                    <a asp-action="Index" class="btn btn-secondary">Back to Departments</a>
                </div>
            </div>
        </div>
    </div>
</div>