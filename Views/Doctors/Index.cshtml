@model IEnumerable<CahwciHospital.Models.Doctor>

@{
    ViewData["Title"] = "Doctors List";
    Layout = "_Layout";
}

<style>
    .doctors-bg {
        min-height: 100vh;
        background: linear-gradient(rgba(0,0,0,0.65), rgba(0,0,0,0.75)),
                    url('/images/Doctors.png') center/cover no-repeat fixed;
        padding: 40px 0;
    }

    .doctors-container {
        background: rgba(255, 255, 255, 0.96);
        border-radius: 15px;
        padding: 30px;
        box-shadow: 0 15px 40px rgba(0, 0, 0, 0.4);
        max-width: 1300px;
        margin: 0 auto;
    }

    .table thead {
        background-color: #0d6efd;
        color: white;
    }

    h1 {
        color: white;
        text-shadow: 0 2px 4px rgba(0,0,0,0.6);
    }
</style>

<div class="doctors-bg">
    <div class="container">
        <div class="doctors-container">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h1>Doctors List</h1>
                <a asp-action="Create" class="btn btn-primary btn-lg">
                    + New Doctor
                </a>
            </div>

            <table class="table table-hover align-middle">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Full Name</th>
                        <th>Specialty</th>
                        <th>Gender</th>
                        <th>Contact Number</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.Id</td>
                            <td>@item.FullName</td>
                            <td>@item.Specialty</td>
                            <td>@item.Gender</td>
                            <td>@item.ContactNumber</td>
                            <td>
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Edit</a>
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info">View</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>