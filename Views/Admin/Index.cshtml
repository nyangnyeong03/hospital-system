@{
    ViewData["Title"] = "Admin Dashboard";
}

<h1 style="text-align:center; color:#2b6fff; margin-top:30px;">
    Admin Dashboard
</h1>

<div style="display:flex;gap:20px;justify-content:center;flex-wrap:wrap;margin-top:40px;">

    <div style="background:white;padding:20px;border-radius:15px;width:200px;text-align:center;box-shadow:0 8px 20px rgba(0,0,0,0.1);">
        <h4>Total Patients</h4>
        <h2 style="color:blue;">120</h2>
    </div>

    <div style="background:white;padding:20px;border-radius:15px;width:200px;text-align:center;box-shadow:0 8px 20px rgba(0,0,0,0.1);">
        <h4>Total Doctors</h4>
        <h2 style="color:green;">15</h2>
    </div>

    <div style="background:white;padding:20px;border-radius:15px;width:200px;text-align:center;box-shadow:0 8px 20px rgba(0,0,0,0.1);">
        <h4>Departments</h4>
        <h2 style="color:orange;">8</h2>
    </div>

    <div style="background:white;padding:20px;border-radius:15px;width:200px;text-align:center;box-shadow:0 8px 20px rgba(0,0,0,0.1);">
        <h4>Appointments</h4>
        <h2 style="color:red;">45</h2>
    </div>

</div>