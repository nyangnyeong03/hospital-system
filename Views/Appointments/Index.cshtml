@model IEnumerable<CahwciHospital.Models.Appointment>

@{
    ViewData["Title"] = "Appointments List";
    Layout = "_Layout";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between mb-4">
        <h2>Appointments List</h2>
        <a asp-action="Create" class="btn btn-success">+ New Appointment Request</a>
    </div>

    <table class="table table-hover">
        <thead>
            <tr>
                <th>ID</th>
                <th>Patient Name</th>
                <th>Preferred Doctor</th>
                <th>Department</th>
                <th>Preferred Date</th>
                <th>Status</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Id</td>
                    <td>@item.PatientName</td>
                    <td>@item.PreferredDoctor</td>
                    <td>@item.Department</td>
                    <td>@item.PreferredDate.ToShortDateString()</td>
                    <td><span class="badge bg-primary">@item.Status</span></td>
                    <td>
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-warning btn-sm">Edit</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>